{
  "name": "koishi-plugin-patchouli-knowledge",
  "version": "0.8.52",
  "description": "帕秋莉的知识库（Patchouli Knowledge）：Koishi 插件，讨论平息后把群聊整理成本地可检索的 llmwiki 词条",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "client",
    "README.md",
    "LICENSE",
    "docs/domain-glossary.md",
    "docs/acceptance-checklist.md"
  ],
  "license": "MIT",
  "scripts": {
    "clean": "node -e \"fs.rmSync('lib', { recursive: true, force: true })\"",
    "build": "tsc -b && node scripts/sync-traffic-client.cjs",
    "test": "node --test \"tests/**/*.test.mjs\" \"tests/**/*.test.js\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "koishi",
    "plugin",
    "qq",
    "llmwiki",
    "cdc",
    "knowledge-base",
    "patchouli",
    "burst-detection",
    "koishi-plugin",
    "chatbot",
    "discord"
  ],
  "peerDependencies": {
    "koishi": "^4.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "koishi": "^4.18.11",
    "typescript": "^5.7.0"
  },
  "koishi": {
    "description": {
      "zh": "「不动的大图书馆」：基于聊天频率自适应突发感知的迟智群聊思维碰撞总结，自动沉淀为 llmwiki 本地知识库"
    }
  },
  "author": "yabo083",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yabo083/koishi-plugin-patchouli-knowledge.git"
  },
  "homepage": "https://github.com/yabo083/koishi-plugin-patchouli-knowledge#readme",
  "bugs": {
    "url": "https://github.com/yabo083/koishi-plugin-patchouli-knowledge/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
